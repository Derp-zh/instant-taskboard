<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Taskboard</AssemblyName>
    <Version>0.9.20</Version>
    <DraftSwitchSpeed Condition="'$(DraftSwitchSpeed)' == ''">1.35</DraftSwitchSpeed>
    <DefineConstants Condition="'$(DraftSwitchSpeed)' == '1.35'">$(DefineConstants);FAST_DRAFT_SWITCH</DefineConstants>
    <Product>即时任务看板</Product>
    <Title>即时任务看板</Title>
    <ApplicationIcon>Assets/orb.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/orb.ico" />
    <EmbeddedResource Include="Assets/Alarm04.wav" LogicalName="Taskboard.DefaultNotification.wav" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <ProjectReference Include="../Taskboard.Core/Taskboard.Core.csproj" />
  </ItemGroup>
</Project>
